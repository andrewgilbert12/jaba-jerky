---
import Wordmark from './Wordmark.astro';
import { navLinks } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="logo" aria-label="Jaba Jerky home"><Wordmark size="1.75rem" /></a>
    <nav aria-label="Main">
      <ul>
        {
          navLinks.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={currentPath === href ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-bg);
    border-bottom: 3px solid var(--brand-pink);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1rem;
  }

  .logo {
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--brand-pink);
  }

  nav a[aria-current='page'] {
    text-decoration: underline wavy var(--brand-pink) 2px;
    text-underline-offset: 6px;
  }
</style>
